```{=html}
<%
  // Quarto flattens a YAML author list into one comma-separated string
  // before the template sees it, so split it back apart before formatting.
  function formatAuthors(author) {
    if (!author) return '';
    var authors = Array.isArray(author) ? author : String(author).split(',');
    authors = authors.map(function (a) { return a.trim(); }).filter(Boolean);
    if (authors.length === 0) return '';
    if (authors.length === 1) return authors[0];
    if (authors.length === 2) return authors[0] + ' and ' + authors[1];
    return authors.slice(0, -1).join(', ') + ', and ' + authors[authors.length - 1];
  }

  // Citation line: published papers show year and journal; everything else
  // shows the date and status. Missing fields are skipped rather than
  // printed as "undefined".
  function citation(item) {
    var parts = item.type === 'Published'
      ? [item.year, formatAuthors(item.author), item.journal]
      : [item.date, formatAuthors(item.author), item.status];
    parts = parts.filter(function (p) { return p !== undefined && p !== null && String(p).trim() !== ''; });
    return parts.length ? parts.join('. ') + '.' : '';
  }

  // Link buttons, in display order. Each entry is [yaml key, icon classes, label].
  // Add or reorder buttons here; nothing else needs to change.
  var linkTypes = [
    ['errata',    'bi bi-exclamation-diamond', 'Errata'],
    ['website',   'bi bi-filetype-html',       'Project Website'],
    ['pdf',       'bi bi-file-earmark-pdf',    'PDF'],
    ['pubopen',   'ai ai-open-access',         'Open Access'],
    ['pubclosed', 'ai ai-closed-access',       "Publisher's Version"],
    ['preprint',  'ai ai-doi',                 'Preprint'],
    ['appendix',  'bi bi-file-earmark-plus',   'Appendix'],
    ['dataverse', 'ai ai-dataverse',           'Dataverse'],
    ['osf',       'ai ai-osf',                 'OSF'],
    ['github',    'bi bi-github',              'GitHub'],
    ['prereg',    'ai ai-preregistered',       'Preregistration']
  ];
%>

<ul class="list">
  <% for (const item of items) { %>
    <% var links = linkTypes.filter(function (l) { return item[l[0]]; }); %>
    <li <%= metadataAttrs(item) %>>
      <span class="paper-title"><%= item.title %></span>
      <br/>
      <p>
      <small class="text-muted"><%= citation(item) %></small>

      <% if (links.length) { %>
        <br/>
        <% for (const l of links) { %>
          <a href="<%= item[l[0]] %>" class="btn btn-outline-secondary btn-xs">
            <i class="<%= l[1] %> ai-lg"></i> <%= l[2] %>
          </a>
        <% } %>
      <% } %>

      <% if (item.note) { %>
        <br/>
        <small class="text-secondary">
          <span class="note"><%= item.note %></span>
        </small>
      <% } %>
      </p>
      <hr>
    </li>
  <% } %>
</ul>
```
